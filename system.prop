# mido-optimize System Properties (v3.0 - GApps build)
# These persist across reboots when installed as Magisk module

# Memory optimization (GMS-friendly, avoids repeated restart-kills)
ro.lmk.use_psi=true
ro.lmk.low_ram=true
ro.lmk.kill_heaviest_task=0
ro.lmk.kill_timeout_ms=2500

# CPU optimization
ro.cpufreq.boost=true

# Logging reduction
persist.logd.logpersistd=stop
log.tag.stats_log=I
persist.vendor.radio.adb_log_on=0
