# mido-optimize System Properties
# These persist across reboots when installed as Magisk module

# Memory optimization
ro.lmk.use_psi=true
ro.lmk.low_ram=true
ro.lmk.kill_heaviest_task=0
ro.lmk.kill_timeout_ms=1500

# CPU optimization
ro.cpufreq.boost=true

# Logging reduction
persist.logd.logpersistd=stop
log.tag.stats_log=I
persist.vendor.radio.adb_log_on=0
